{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MCP Server (server.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "MONGO_URI": "mongodb://localhost:27017/",
        "MONGO_DB": "production_db",
        "MONGO_COLLECTION": "production_records",
        "SENDER_EMAIL": "your-email@gmail.com",
        "SENDER_PASSWORD": "your-gmail-app-password",
        "RECIPIENT_EMAIL": "recipient@example.com",
        "MANIFEST_URL": "https://your-app.onrender.com"
      }
    },
    {
      "name": "Debug MCP Server (Inspector via mcp dev)",
      "type": "debugpy",
      "request": "launch",
      "module": "mcp",
      "args": ["dev", "${workspaceFolder}/server.py"],
      "console": "integratedTerminal",
      "env": {
        "MONGO_URI": "mongodb://localhost:27017/",
        "MONGO_DB": "production_db",
        "MONGO_COLLECTION": "production_records",
        "SENDER_EMAIL": "your-email@gmail.com",
        "SENDER_PASSWORD": "your-gmail-app-password",
        "RECIPIENT_EMAIL": "recipient@example.com",
        "MANIFEST_URL": "https://your-app.onrender.com"
      }
    }
  ]
}
